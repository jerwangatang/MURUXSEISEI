// FADE TRANSITION - CREATE
// ==================================================

// Survive room changes
persistent = true;

// Fade amount
// 0 = transparent
// 1 = completely black
fade_alpha = 0;

// 0 = fading OUT
// 1 = fading IN
fade_state = 0;

// Change this to adjust speed
fade_speed = 0.025;

// Destination room
target_room = noone;